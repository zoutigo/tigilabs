generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum AuthTokenType {
  EMAIL_CONFIRMATION
  PASSWORD_RESET
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskGroupStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  firstName    String?
  lastName     String?
  name         String
  passwordHash String
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles            UserRole[]
  authTokens       AuthToken[]
  assignedTasks    Task[]        @relation("TaskAssignee")
  createdTasks     Task[]        @relation("TaskCreator")
  completedTasks   Task[]        @relation("TaskCompleter")
  createdTaskGroups TaskGroup[]  @relation("TaskGroupCreator")
  taskProgress     TaskProgress[]
  taskHistory      TaskHistory[]
  comments         Comment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
}

model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, usedAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  action      String
  subject     String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([action, subject])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  startDate   DateTime     @default(now())
  dueDate     DateTime?
  completedAt DateTime?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  groupId       String
  assignedToId  String?
  createdById   String
  completedById String?

  group       TaskGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedTo  User?     @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy User?     @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  progress    TaskProgress[]
  history     TaskHistory[]
  comments    Comment[]

  @@index([groupId, status])
  @@index([assignedToId, status])
  @@index([dueDate])
}

model TaskGroup {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      TaskGroupStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  archivedAt  DateTime?

  createdById String
  createdBy   User   @relation("TaskGroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]

  @@index([status, createdAt])
}

model TaskProgress {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  taskId   String
  authorId String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskHistory {
  id        String   @id @default(cuid())
  action    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  subject   String
  subjectId String?
  metadata  Json?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}
