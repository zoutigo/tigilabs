generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum AuthTokenType {
  EMAIL_CONFIRMATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskGroupStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  pendingEmail String?
  firstName    String?
  lastName     String?
  name         String
  passwordHash    String
  status          UserStatus @default(INVITED)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles            UserRole[]
  authTokens       AuthToken[]
  assignedTasks    Task[]        @relation("TaskAssignee")
  createdTasks     Task[]        @relation("TaskCreator")
  completedTasks   Task[]        @relation("TaskCompleter")
  createdTaskGroups TaskGroup[]  @relation("TaskGroupCreator")
  taskProgress     TaskProgress[]
  taskHistory      TaskHistory[]
  comments         Comment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  readContactMessages ContactMessage[]

  organizedEvents         Event[]            @relation("EventOrganizer")
  eventParticipations     EventParticipant[]
  eventHistory            EventHistory[]
  uploadedEventAttachments EventAttachment[]
  calendarCategories      CalendarCategory[]
  eventReminders          EventReminder[]
}

model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, usedAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  action      String
  subject     String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([action, subject])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  startDate   DateTime     @default(now())
  dueDate     DateTime?
  completedAt DateTime?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  groupId       String
  assignedToId  String?
  createdById   String
  completedById String?

  group       TaskGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedTo  User?     @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy User?     @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  progress    TaskProgress[]
  history     TaskHistory[]
  comments    Comment[]

  @@index([groupId, status])
  @@index([assignedToId, status])
  @@index([dueDate])
}

model TaskGroup {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      TaskGroupStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  archivedAt  DateTime?

  createdById String
  createdBy   User   @relation("TaskGroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]

  @@index([status, createdAt])
}

model TaskProgress {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  taskId   String
  authorId String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskHistory {
  id        String   @id @default(cuid())
  action    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  subject   String
  subjectId String?
  metadata  Json?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SiteSettings {
  id            String   @id @default(cuid())
  companyName   String   @default("Tigilabs")
  ownerName     String
  contactEmail  String
  contactPhone  String
  address       String?
  privacyPolicy String
  updatedAt     DateTime @updatedAt
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    ContactMessageStatus @default(NEW)
  ipAddress String?
  createdAt DateTime             @default(now())
  readAt    DateTime?

  readById String?
  readBy   User?   @relation(fields: [readById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

enum EventStatus {
  CONFIRMED
  CANCELLED
}

enum EventPrivacy {
  NORMAL
  PRIVATE
  RESTRICTED
}

enum ParticipantStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum ReminderChannel {
  EMAIL
  IN_APP
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum JobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum JobType {
  EVENT_INVITATION
  EVENT_UPDATE
  EVENT_CANCELLATION
  EVENT_REMINDER
}

model CalendarCategory {
  id        String   @id @default(cuid())
  name      String
  color     String
  isGlobal  Boolean  @default(false)
  createdAt DateTime @default(now())

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  events Event[]

  @@index([ownerId])
}

model EventSeries {
  id        String              @id @default(cuid())
  frequency RecurrenceFrequency
  interval  Int                 @default(1)
  byWeekday Int[]               @default([])
  until     DateTime?
  count     Int?
  createdAt DateTime            @default(now())

  events Event[]
}

model Event {
  id          String       @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean      @default(false)
  timezone    String
  location    String?
  meetingUrl  String?
  privacy     EventPrivacy @default(NORMAL)
  status      EventStatus  @default(CONFIRMED)
  cancelledAt DateTime?

  recurrenceExceptionOf DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String?
  category   CalendarCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  organizerId String
  organizer   User   @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)

  seriesId String?
  series   EventSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  participants EventParticipant[]
  reminders    EventReminder[]
  attachments  EventAttachment[]
  history      EventHistory[]

  @@index([organizerId, startAt])
  @@index([startAt, endAt])
  @@index([seriesId])
}

model EventParticipant {
  eventId     String
  userId      String
  status      ParticipantStatus @default(PENDING)
  respondedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId, status])
}

model EventReminder {
  id            String          @id @default(cuid())
  minutesBefore Int
  channel       ReminderChannel

  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, userId])
}

model EventAttachment {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  createdAt    DateTime @default(now())

  eventId      String
  uploadedById String

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([eventId])
}

model EventHistory {
  id        String   @id @default(cuid())
  action    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

model OutboxJob {
  id           String    @id @default(cuid())
  type         JobType
  payload      Json
  scheduledFor DateTime  @default(now())
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([status, scheduledFor])
}
