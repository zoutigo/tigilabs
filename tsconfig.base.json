{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@tigilabs/types": ["packages/types/src/index.ts"],
      "@tigilabs/schemas": ["packages/schemas/src/index.ts"],
      "@tigilabs/config": ["packages/config/src/index.ts"],
      "@tigilabs/ui": ["packages/ui/src/index.ts"]
    }
  }
}
